# Copy this file to secrets.toml and fill in your actual values
# Streamlit will automatically load secrets.toml when running locally

[chromadb]
api_key = "your-chromadb-api-key-here"
tenant = "your-chromadb-tenant-here"
database = "your-chromadb-database-name"

[azure_openai]
endpoint = "https://your-endpoint.openai.azure.com/"
api_key = "your-azure-openai-api-key"
api_version = "2025-01-01-preview"
deployment = "gpt-4o-mini"  # Will be used for both chat and embeddings

# Optional: MongoDB configuration
[mongodb]
uri = "mongodb://localhost:27017"
database = "vaia_market_analyst"

